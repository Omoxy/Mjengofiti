# Mjengofiti Environment Configuration
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# Application
APP_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=info
APP_CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mjengofiti
DB_USER=mjengofiti
DB_PASSWORD=CHANGE_ME_IN_ENV
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Authentication
AUTH_ENABLED=false
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_AUDIENCE=
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET

# Map Configuration
MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/style.json
MAP_DEFAULT_CENTER_LNG=36.8219
MAP_DEFAULT_CENTER_LAT=-1.2921
MAP_DEFAULT_ZOOM=11

# Data Ingestion
INGESTION_MAX_FILE_SIZE_MB=500
INGESTION_TEMP_DIR=./tmp/ingestion
INGESTION_WORKERS=2

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
